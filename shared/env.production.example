# Production Environment Configuration
# Copy this file to .env and update with your actual values

# Frontend Configuration
FRONTEND_PORT=3000
FRONTEND_HOST=0.0.0.0

# ALB/Ingress Base URL Configuration
ALB_BASE_URL=https://api.micromesh.com

# AWS Certificate Manager SSL Configuration
AWS_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/your-certificate-id

# Auth Service Configuration
AUTH_SERVICE_PORT=8081
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_URL=http://localhost:8081
AUTH_SERVICE_ALB_URL=https://api.micromesh.com/auth

# Product Service Configuration
PRODUCT_SERVICE_PORT=8082
PRODUCT_SERVICE_HOST=localhost
PRODUCT_SERVICE_URL=http://localhost:8082
PRODUCT_SERVICE_ALB_URL=https://api.micromesh.com/products

# Order Service Configuration
ORDER_SERVICE_PORT=8083
ORDER_SERVICE_HOST=localhost
ORDER_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_ALB_URL=https://api.micromesh.com/orders

# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017
AUTH_DB_NAME=auth_service_db
PRODUCT_DB_NAME=product_service_db
ORDER_DB_NAME=order_service_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=86400000

# Service Health Check Intervals (in milliseconds)
HEALTH_CHECK_INTERVAL=5000

# Environment Configuration
ENVIRONMENT=production

# Use ALB URLs in production
USE_ALB_ROUTING=true 