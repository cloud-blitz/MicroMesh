<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MicroMesh E-Commerce Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #667eea;
            --secondary: #764ba2;
            --success: #10b981;
            --warning: #f59e0b;
            --error: #ef4444;
            --dark: #1f2937;
        }
        
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }
        
        .glass-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 16px;
        }
        
        .service-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 16px;
            padding: 24px;
            color: white;
            transition: all 0.3s ease;
        }
        
        .service-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }
        
        .status-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 8px;
        }
        
        .status-active {
            background: #10b981;
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
            animation: pulse 2s infinite;
        }
        
        .status-inactive {
            background: #ef4444;
            animation: blink 1s step-end infinite;
        }
        
        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
            100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }
        
        @keyframes blink {
            50% { opacity: 0.3; }
        }
        
        .form-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        }
        
        .form-input {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            font-size: 14px;
            transition: all 0.3s ease;
        }
        
        .form-input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
        }
        
        .debug-panel {
            background: #1f2937;
            color: #f9fafb;
            border-radius: 8px;
            padding: 16px;
            margin-top: 16px;
            font-family: 'Courier New', monospace;
            font-size: 12px;
            max-height: 300px;
            overflow-y: auto;
        }
        
        .success-response {
            border-color: #10b981;
            background: #f0fdf4;
        }
        
        .error-response {
            border-color: #ef4444;
            background: #fef2f2;
        }
        
        .tab-button {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            padding: 12px 24px;
            border: none;
            border-radius: 8px 8px 0 0;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .tab-button.active {
            background: rgba(255, 255, 255, 0.95);
            color: #374151;
        }
        
        .tab-content {
            display: none;
        }
        
        .tab-content.active {
            display: block;
        }
        
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 16px;
            margin-top: 16px;
        }
        
        .product-card {
            background: white;
            border-radius: 12px;
            padding: 16px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
        }
        
        .product-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }
        
        .order-card {
            background: white;
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 16px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        .debug-toggle {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }
        
        .loading-spinner {
            width: 20px;
            height: 20px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid #667eea;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <!-- Debug Toggle -->
    <div class="debug-toggle">
        <button id="debug-toggle" class="btn-primary">
            <i class="fas fa-bug mr-2"></i>Debug Mode
        </button>
    </div>

    <!-- Header -->
    <header class="glass-card p-6 mb-8 mx-4 mt-4">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <div class="flex items-center space-x-4">
                <div class="w-12 h-12 bg-white rounded-lg flex items-center justify-center">
                    <i class="fas fa-shopping-cart text-2xl text-purple-600"></i>
                </div>
                <div>
                    <h1 class="text-3xl font-bold text-white">MicroMesh E-Commerce</h1>
                    <p class="text-white opacity-80">Complete microservices testing platform with debug mode</p>
                </div>
            </div>
            <div class="flex items-center space-x-4">
                <div class="text-white opacity-80">
                    <i class="fas fa-clock mr-2"></i>
                    <span id="current-time"></span>
                </div>
                <div class="text-white opacity-80">
                    <i class="fas fa-signal mr-2"></i>
                    <span id="request-count">0</span> requests
                </div>
            </div>
        </div>
    </header>

    <div class="max-w-7xl mx-auto px-4">
        <!-- Service Status Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <% services.forEach(svc => { %>
                <div class="service-card">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center">
                            <span class="status-dot status-<%= svc.status %>"></span>
                            <h3 class="text-xl font-semibold"><%= svc.name %></h3>
                        </div>
                        <div class="text-right">
                            <div class="text-2xl font-bold"><%= svc.status.toUpperCase() %></div>
                            <div class="text-sm opacity-80">Port <%= svc.url ? svc.url.split(':')[2].split('/')[0] : 'N/A' %></div>
                        </div>
                    </div>
                    
                    <div class="text-sm opacity-80 leading-relaxed mt-4">
                        <i class="fas fa-info-circle mr-1"></i>
                        <%= svc.description %>
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- Main Dashboard Tabs -->
        <div class="glass-card p-8 mb-8">
            <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
                <i class="fas fa-tachometer-alt mr-3"></i>
                E-Commerce Dashboard
            </h2>
            
            <!-- Tab Buttons -->
            <div class="flex space-x-2 mb-6">
                <button class="tab-button active" onclick="showTab('dashboard')">
                    <i class="fas fa-chart-line mr-2"></i>Dashboard
                </button>
                <button class="tab-button" onclick="showTab('auth')">
                    <i class="fas fa-user-shield mr-2"></i>Authentication
                </button>
                <button class="tab-button" onclick="showTab('products')">
                    <i class="fas fa-box mr-2"></i>Products
                </button>
                <button class="tab-button" onclick="showTab('orders')">
                    <i class="fas fa-shopping-cart mr-2"></i>Orders
                </button>
                <button class="tab-button" onclick="showTab('debug')">
                    <i class="fas fa-bug mr-2"></i>Debug Console
                </button>
            </div>

            <!-- Dashboard Tab -->
            <div id="dashboard-tab" class="tab-content active">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                    <div class="form-card">
                        <div class="flex items-center">
                            <div class="p-3 rounded-full bg-blue-100 text-blue-600">
                                <i class="fas fa-users text-xl"></i>
                            </div>
                            <div class="ml-4">
                                <h3 class="text-lg font-semibold text-gray-800">Total Users</h3>
                                <p class="text-2xl font-bold text-blue-600" id="user-count">0</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-card">
                        <div class="flex items-center">
                            <div class="p-3 rounded-full bg-green-100 text-green-600">
                                <i class="fas fa-box text-xl"></i>
                            </div>
                            <div class="ml-4">
                                <h3 class="text-lg font-semibold text-gray-800">Total Products</h3>
                                <p class="text-2xl font-bold text-green-600" id="product-count">0</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-card">
                        <div class="flex items-center">
                            <div class="p-3 rounded-full bg-purple-100 text-purple-600">
                                <i class="fas fa-shopping-cart text-xl"></i>
                            </div>
                            <div class="ml-4">
                                <h3 class="text-lg font-semibold text-gray-800">Total Orders</h3>
                                <p class="text-2xl font-bold text-purple-600" id="order-count">0</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-card">
                        <div class="flex items-center">
                            <div class="p-3 rounded-full bg-orange-100 text-orange-600">
                                <i class="fas fa-dollar-sign text-xl"></i>
                            </div>
                            <div class="ml-4">
                                <h3 class="text-lg font-semibold text-gray-800">Total Revenue</h3>
                                <p class="text-2xl font-bold text-orange-600" id="revenue">$0</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Charts -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div class="form-card">
                        <h3 class="text-xl font-bold text-gray-800 mb-4">Recent Activity</h3>
                        <canvas id="activityChart" width="400" height="200"></canvas>
                    </div>
                    
                    <div class="form-card">
                        <h3 class="text-xl font-bold text-gray-800 mb-4">Service Health</h3>
                        <canvas id="healthChart" width="400" height="200"></canvas>
                    </div>
                </div>
            </div>

            <!-- Auth Tab -->
            <div id="auth-tab" class="tab-content">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- User Registration Form -->
                    <div class="form-card">
                        <h3 class="text-xl font-bold text-gray-800 mb-4">
                            <i class="fas fa-user-plus mr-2 text-green-600"></i>
                            User Registration
                        </h3>
                        <form id="register-form">
                            <div class="mb-4">
                                <label class="block text-sm font-medium text-gray-700 mb-2">Username</label>
                                <input type="text" name="username" class="form-input" placeholder="Enter username" required>
                            </div>
                            <div class="mb-4">
                                <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                                <input type="email" name="email" class="form-input" placeholder="Enter email" required>
                            </div>
                            <div class="mb-4">
                                <label class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                                <input type="password" name="password" class="form-input" placeholder="Enter password" required>
                            </div>
                            <button type="submit" class="btn-primary w-full">
                                <i class="fas fa-user-plus mr-2"></i>Register User
                            </button>
                        </form>
                        <div id="register-debug" class="debug-panel" style="display: none;"></div>
                    </div>

                    <!-- User Login Form -->
                    <div class="form-card">
                        <h3 class="text-xl font-bold text-gray-800 mb-4">
                            <i class="fas fa-sign-in-alt mr-2 text-blue-600"></i>
                            User Login
                        </h3>
                        <form id="login-form">
                            <div class="mb-4">
                                <label class="block text-sm font-medium text-gray-700 mb-2">Username</label>
                                <input type="text" name="username" class="form-input" placeholder="Enter username" required>
                            </div>
                            <div class="mb-4">
                                <label class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                                <input type="password" name="password" class="form-input" placeholder="Enter password" required>
                            </div>
                            <button type="submit" class="btn-primary w-full">
                                <i class="fas fa-sign-in-alt mr-2"></i>Login
                            </button>
                        </form>
                        <div id="login-debug" class="debug-panel" style="display: none;"></div>
                    </div>
                </div>
            </div>

            <!-- Products Tab -->
            <div id="products-tab" class="tab-content">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Add Product Form -->
                    <div class="form-card">
                        <h3 class="text-xl font-bold text-gray-800 mb-4">
                            <i class="fas fa-plus-circle mr-2 text-green-600"></i>
                            Add New Product
                        </h3>
                        <form id="add-product-form">
                            <div class="mb-4">
                                <label class="block text-sm font-medium text-gray-700 mb-2">Product Name</label>
                                <input type="text" name="name" class="form-input" placeholder="Enter product name" required>
                            </div>
                            <div class="mb-4">
                                <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
                                <textarea name="description" class="form-input" rows="3" placeholder="Enter product description" required></textarea>
                            </div>
                            <div class="grid grid-cols-2 gap-4 mb-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Price</label>
                                    <input type="number" name="price" class="form-input" placeholder="0.00" step="0.01" min="0" required>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Stock</label>
                                    <input type="number" name="stockQuantity" class="form-input" placeholder="0" min="0" required>
                                </div>
                            </div>
                            <button type="submit" class="btn-primary w-full">
                                <i class="fas fa-plus-circle mr-2"></i>Add Product
                            </button>
                        </form>
                        <div id="add-product-debug" class="debug-panel" style="display: none;"></div>
                    </div>

                    <!-- Products List -->
                    <div class="form-card">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-xl font-bold text-gray-800">
                                <i class="fas fa-list mr-2 text-blue-600"></i>
                                Products Catalog
                            </h3>
                            <button onclick="loadProducts()" class="btn-primary">
                                <i class="fas fa-refresh mr-2"></i>Refresh
                            </button>
                        </div>
                        <div id="products-list" class="product-grid">
                            <div class="text-center text-gray-500 py-8">
                                <i class="fas fa-box text-4xl mb-4"></i>
                                <p>No products loaded</p>
                            </div>
                        </div>
                        <div id="products-debug" class="debug-panel" style="display: none;"></div>
                    </div>
                </div>
            </div>

            <!-- Orders Tab -->
            <div id="orders-tab" class="tab-content">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Create Order Form -->
                    <div class="form-card">
                        <h3 class="text-xl font-bold text-gray-800 mb-4">
                            <i class="fas fa-shopping-cart mr-2 text-green-600"></i>
                            Create New Order
                        </h3>
                        <form id="create-order-form">
                            <div class="mb-4">
                                <label class="block text-sm font-medium text-gray-700 mb-2">Customer Name</label>
                                <input type="text" name="customerName" class="form-input" placeholder="Enter customer name" required>
                            </div>
                            <div class="mb-4">
                                <label class="block text-sm font-medium text-gray-700 mb-2">Customer Email</label>
                                <input type="email" name="customerEmail" class="form-input" placeholder="Enter customer email" required>
                            </div>
                            <div class="mb-4">
                                <label class="block text-sm font-medium text-gray-700 mb-2">Product ID</label>
                                <input type="text" name="productId" class="form-input" placeholder="Enter product ID" required>
                            </div>
                            <div class="mb-4">
                                <label class="block text-sm font-medium text-gray-700 mb-2">Product Name</label>
                                <input type="text" name="productName" class="form-input" placeholder="Enter product name" required>
                            </div>
                            <div class="grid grid-cols-2 gap-4 mb-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Quantity</label>
                                    <input type="number" name="quantity" class="form-input" placeholder="1" min="1" required>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Price</label>
                                    <input type="number" name="price" class="form-input" placeholder="0.00" step="0.01" min="0" required>
                                </div>
                            </div>
                            <button type="submit" class="btn-primary w-full">
                                <i class="fas fa-shopping-cart mr-2"></i>Create Order
                            </button>
                        </form>
                        <div id="create-order-debug" class="debug-panel" style="display: none;"></div>
                    </div>

                    <!-- Orders List -->
                    <div class="form-card">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-xl font-bold text-gray-800">
                                <i class="fas fa-list mr-2 text-blue-600"></i>
                                Recent Orders
                            </h3>
                            <button onclick="loadOrders()" class="btn-primary">
                                <i class="fas fa-refresh mr-2"></i>Refresh
                            </button>
                        </div>
                        <div id="orders-list">
                            <div class="text-center text-gray-500 py-8">
                                <i class="fas fa-shopping-cart text-4xl mb-4"></i>
                                <p>No orders loaded</p>
                            </div>
                        </div>
                        <div id="orders-debug" class="debug-panel" style="display: none;"></div>
                    </div>
                </div>
            </div>

            <!-- Debug Console Tab -->
            <div id="debug-tab" class="tab-content">
                <div class="form-card">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-xl font-bold text-gray-800">
                            <i class="fas fa-terminal mr-2 text-purple-600"></i>
                            Debug Console
                        </h3>
                        <div class="flex space-x-2">
                            <button onclick="clearDebugLog()" class="btn-primary">
                                <i class="fas fa-trash mr-2"></i>Clear
                            </button>
                            <button onclick="exportDebugLog()" class="btn-primary">
                                <i class="fas fa-download mr-2"></i>Export
                            </button>
                        </div>
                    </div>
                    <div id="debug-console" class="debug-panel" style="height: 400px;">
                        <div class="text-green-400">=== MicroMesh Debug Console ===</div>
                        <div class="text-gray-400">Ready to capture all API requests and responses...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Real-time Activity Feed -->
        <div class="glass-card p-8">
            <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
                <i class="fas fa-stream mr-3"></i>
                Real-time Activity Feed
            </h2>
            <div id="activity-feed" class="space-y-4 max-h-96 overflow-y-auto">
                <div class="flex items-center p-4 bg-white bg-opacity-10 rounded-lg">
                    <div class="loading-spinner mr-4"></div>
                    <div class="text-white">
                        <div class="font-semibold">Initializing e-commerce dashboard...</div>
                        <div class="text-sm opacity-80">Ready to test all microservices</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Global variables
        let debugMode = false;
        let requestCount = 0;
        let debugLog = [];
        
        // Initialize charts
        function initCharts() {
            // Activity Chart
            const activityCtx = document.getElementById('activityChart').getContext('2d');
            new Chart(activityCtx, {
                type: 'line',
                data: {
                    labels: ['00:00', '04:00', '08:00', '12:00', '16:00', '20:00'],
                    datasets: [{
                        label: 'API Requests',
                        data: [12, 19, 3, 5, 2, 3],
                        borderColor: '#667eea',
                        backgroundColor: 'rgba(102, 126, 234, 0.1)',
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });

            // Health Chart
            const healthCtx = document.getElementById('healthChart').getContext('2d');
            new Chart(healthCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Auth Service', 'Product Service', 'Order Service'],
                    datasets: [{
                        data: [100, 100, 100],
                        backgroundColor: ['#10b981', '#f59e0b', '#ef4444'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    }
                }
            });
        }

        // Debug functions
        function toggleDebugMode() {
            debugMode = !debugMode;
            const button = document.getElementById('debug-toggle');
            const debugPanels = document.querySelectorAll('.debug-panel');
            
            if (debugMode) {
                button.innerHTML = '<i class="fas fa-eye-slash mr-2"></i>Hide Debug';
                button.classList.add('bg-red-600');
                debugPanels.forEach(panel => panel.style.display = 'block');
                addDebugLog('DEBUG MODE ENABLED', 'info');
            } else {
                button.innerHTML = '<i class="fas fa-bug mr-2"></i>Debug Mode';
                button.classList.remove('bg-red-600');
                debugPanels.forEach(panel => panel.style.display = 'none');
                addDebugLog('DEBUG MODE DISABLED', 'info');
            }
        }

        function addDebugLog(message, type = 'info', data = null) {
            const timestamp = new Date().toISOString();
            const logEntry = {
                timestamp,
                type,
                message,
                data
            };
            
            debugLog.push(logEntry);
            
            if (debugMode) {
                const console = document.getElementById('debug-console');
                const logLine = document.createElement('div');
                logLine.className = `text-sm ${type === 'error' ? 'text-red-400' : type === 'success' ? 'text-green-400' : 'text-blue-400'}`;
                logLine.innerHTML = `[${timestamp.split('T')[1].split('.')[0]}] ${message}`;
                console.appendChild(logLine);
                console.scrollTop = console.scrollHeight;
            }
        }

        function clearDebugLog() {
            debugLog = [];
            document.getElementById('debug-console').innerHTML = '<div class="text-green-400">=== MicroMesh Debug Console ===</div>';
        }

        function exportDebugLog() {
            const dataStr = JSON.stringify(debugLog, null, 2);
            const dataBlob = new Blob([dataStr], {type: 'application/json'});
            const url = URL.createObjectURL(dataBlob);
            const link = document.createElement('a');
            link.href = url;
            link.download = `micromesh-debug-${new Date().toISOString().split('T')[0]}.json`;
            link.click();
        }

        // Tab functionality
        function showTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });
            document.querySelectorAll('.tab-button').forEach(btn => {
                btn.classList.remove('active');
            });

            document.getElementById(tabName + '-tab').classList.add('active');
            event.target.classList.add('active');
        }

        // Utility functions
        function updateTime() {
            const now = new Date();
            document.getElementById('current-time').textContent = now.toLocaleTimeString();
        }

        function updateRequestCount() {
            document.getElementById('request-count').textContent = requestCount;
        }

        function addActivity(message, type = 'info') {
            const feed = document.getElementById('activity-feed');
            const activity = document.createElement('div');
            activity.className = 'flex items-center p-4 bg-white bg-opacity-10 rounded-lg';
            
            const icon = type === 'success' ? 'fas fa-check-circle text-green-400' : 
                        type === 'error' ? 'fas fa-exclamation-circle text-red-400' : 
                        'fas fa-info-circle text-blue-400';
            
            activity.innerHTML = `
                <i class="${icon} mr-4 text-xl"></i>
                <div class="text-white">
                    <div class="font-semibold">${message}</div>
                    <div class="text-sm opacity-80">${new Date().toLocaleTimeString()}</div>
                </div>
            `;
            
            feed.insertBefore(activity, feed.firstChild);
            
            if (feed.children.length > 10) {
                feed.removeChild(feed.lastChild);
            }
        }

        // API wrapper with debug logging
        async function apiCall(endpoint, options = {}, debugId = '') {
            requestCount++;
            updateRequestCount();
            
            const startTime = Date.now();
            const requestData = {
                url: endpoint,
                method: options.method || 'GET',
                headers: options.headers || {},
                body: options.body ? JSON.parse(options.body) : null
            };
            
            addDebugLog(`🚀 REQUEST ${debugId}: ${requestData.method} ${endpoint}`, 'info', requestData);
            addActivity(`API Request: ${requestData.method} ${endpoint.split('/').pop()}`, 'info');
            
            try {
                const response = await fetch(endpoint, options);
                const responseTime = Date.now() - startTime;
                const responseData = await response.json();
                
                const debugInfo = {
                    status: response.status,
                    statusText: response.statusText,
                    responseTime: `${responseTime}ms`,
                    data: responseData
                };
                
                addDebugLog(`✅ RESPONSE ${debugId}: ${response.status} (${responseTime}ms)`, 
                    response.ok ? 'success' : 'error', debugInfo);
                
                if (response.ok) {
                    addActivity(`API Success: ${endpoint.split('/').pop()}`, 'success');
                } else {
                    addActivity(`API Error: ${response.status}`, 'error');
                }
                
                return { response, data: responseData };
            } catch (error) {
                const errorTime = Date.now() - startTime;
                addDebugLog(`❌ ERROR ${debugId}: ${error.message} (${errorTime}ms)`, 'error', { error: error.message });
                addActivity(`API Error: ${error.message}`, 'error');
                throw error;
            }
        }

        // Auth Service API calls
        document.getElementById('register-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData);
            
            try {
                const { response, data: result } = await apiCall('/api/auth/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                }, 'REGISTER');
                
                if (response.ok) {
                    document.getElementById('register-debug').innerHTML = `<div class="text-green-400">✅ Success</div><pre>${JSON.stringify(result, null, 2)}</pre>`;
                    document.getElementById('register-debug').style.display = debugMode ? 'block' : 'none';
                } else {
                    document.getElementById('register-debug').innerHTML = `<div class="text-red-400">❌ Error</div><pre>${JSON.stringify(result, null, 2)}</pre>`;
                    document.getElementById('register-debug').style.display = debugMode ? 'block' : 'none';
                }
            } catch (error) {
                document.getElementById('register-debug').innerHTML = `<div class="text-red-400">❌ Network Error</div><pre>${error.message}</pre>`;
                document.getElementById('register-debug').style.display = debugMode ? 'block' : 'none';
            }
        });

        document.getElementById('login-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData);
            
            try {
                const { response, data: result } = await apiCall('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                }, 'LOGIN');
                
                if (response.ok) {
                    document.getElementById('login-debug').innerHTML = `<div class="text-green-400">✅ Success</div><pre>${JSON.stringify({...result, token: '***HIDDEN***'}, null, 2)}</pre>`;
                    document.getElementById('login-debug').style.display = debugMode ? 'block' : 'none';
                } else {
                    document.getElementById('login-debug').innerHTML = `<div class="text-red-400">❌ Error</div><pre>${JSON.stringify(result, null, 2)}</pre>`;
                    document.getElementById('login-debug').style.display = debugMode ? 'block' : 'none';
                }
            } catch (error) {
                document.getElementById('login-debug').innerHTML = `<div class="text-red-400">❌ Network Error</div><pre>${error.message}</pre>`;
                document.getElementById('login-debug').style.display = debugMode ? 'block' : 'none';
            }
        });

        // Product Service API calls
        document.getElementById('add-product-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData);
            data.price = parseFloat(data.price);
            data.stockQuantity = parseInt(data.stockQuantity);
            
            try {
                const { response, data: result } = await apiCall('/api/products', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                }, 'ADD_PRODUCT');
                
                if (response.ok) {
                    document.getElementById('add-product-debug').innerHTML = `<div class="text-green-400">✅ Success</div><pre>${JSON.stringify(result, null, 2)}</pre>`;
                    document.getElementById('add-product-debug').style.display = debugMode ? 'block' : 'none';
                    loadProducts(); // Refresh products list
                } else {
                    document.getElementById('add-product-debug').innerHTML = `<div class="text-red-400">❌ Error</div><pre>${JSON.stringify(result, null, 2)}</pre>`;
                    document.getElementById('add-product-debug').style.display = debugMode ? 'block' : 'none';
                }
            } catch (error) {
                document.getElementById('add-product-debug').innerHTML = `<div class="text-red-400">❌ Network Error</div><pre>${error.message}</pre>`;
                document.getElementById('add-product-debug').style.display = debugMode ? 'block' : 'none';
            }
        });

        async function loadProducts() {
            try {
                const { response, data: products } = await apiCall('/api/products', {}, 'GET_PRODUCTS');
                
                if (response.ok) {
                    const productsList = document.getElementById('products-list');
                    document.getElementById('product-count').textContent = products.length;
                    
                    if (products.length === 0) {
                        productsList.innerHTML = '<div class="text-center text-gray-500 py-8"><i class="fas fa-box text-4xl mb-4"></i><p>No products available</p></div>';
                    } else {
                        productsList.innerHTML = products.map(product => `
                            <div class="product-card">
                                <h4 class="font-semibold text-gray-800 mb-2">${product.name}</h4>
                                <p class="text-gray-600 text-sm mb-2">${product.description}</p>
                                <div class="flex justify-between items-center">
                                    <span class="text-green-600 font-bold">$${product.price}</span>
                                    <span class="text-gray-500 text-sm">Stock: ${product.stockQuantity}</span>
                                </div>
                            </div>
                        `).join('');
                    }
                    
                    document.getElementById('products-debug').innerHTML = `<div class="text-green-400">✅ Loaded ${products.length} products</div><pre>${JSON.stringify(products, null, 2)}</pre>`;
                    document.getElementById('products-debug').style.display = debugMode ? 'block' : 'none';
                } else {
                    document.getElementById('products-debug').innerHTML = `<div class="text-red-400">❌ Error loading products</div><pre>${JSON.stringify(products, null, 2)}</pre>`;
                    document.getElementById('products-debug').style.display = debugMode ? 'block' : 'none';
                }
            } catch (error) {
                document.getElementById('products-debug').innerHTML = `<div class="text-red-400">❌ Network Error</div><pre>${error.message}</pre>`;
                document.getElementById('products-debug').style.display = debugMode ? 'block' : 'none';
            }
        }

        // Order Service API calls
        document.getElementById('create-order-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData);
            
            // Format the data according to backend requirements
            const orderData = {
                customerName: data.customerName,
                customerEmail: data.customerEmail,
                items: [{
                    productId: data.productId,
                    productName: data.productName,
                    quantity: parseInt(data.quantity),
                    price: parseFloat(data.price)
                }]
            };
            
            try {
                const { response, data: result } = await apiCall('/api/orders', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(orderData)
                }, 'CREATE_ORDER');
                
                if (response.ok) {
                    document.getElementById('create-order-debug').innerHTML = `<div class="text-green-400">✅ Success</div><pre>${JSON.stringify(result, null, 2)}</pre>`;
                    document.getElementById('create-order-debug').style.display = debugMode ? 'block' : 'none';
                    loadOrders(); // Refresh orders list
                } else {
                    document.getElementById('create-order-debug').innerHTML = `<div class="text-red-400">❌ Error</div><pre>${JSON.stringify(result, null, 2)}</pre>`;
                    document.getElementById('create-order-debug').style.display = debugMode ? 'block' : 'none';
                }
            } catch (error) {
                document.getElementById('create-order-debug').innerHTML = `<div class="text-red-400">❌ Network Error</div><pre>${error.message}</pre>`;
                document.getElementById('create-order-debug').style.display = debugMode ? 'block' : 'none';
            }
        });

        async function loadOrders() {
            try {
                const { response, data: orders } = await apiCall('/api/orders', {}, 'GET_ORDERS');
                
                if (response.ok) {
                    const ordersList = document.getElementById('orders-list');
                    document.getElementById('order-count').textContent = orders.length;
                    
                    if (orders.length === 0) {
                        ordersList.innerHTML = '<div class="text-center text-gray-500 py-8"><i class="fas fa-shopping-cart text-4xl mb-4"></i><p>No orders available</p></div>';
                    } else {
                        ordersList.innerHTML = orders.map(order => `
                            <div class="order-card">
                                <div class="flex justify-between items-start mb-2">
                                    <h4 class="font-semibold text-gray-800">Order #${order.id}</h4>
                                    <span class="text-sm px-2 py-1 rounded-full ${order.status === 'PENDING' ? 'bg-yellow-100 text-yellow-800' : order.status === 'COMPLETED' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}">${order.status}</span>
                                </div>
                                <p class="text-gray-600 text-sm mb-2">Customer: ${order.customerName}</p>
                                <p class="text-gray-600 text-sm mb-2">Items: ${order.items ? order.items.length : 0}</p>
                                <p class="text-green-600 font-bold">Total: $${order.totalAmount || 0}</p>
                            </div>
                        `).join('');
                    }
                    
                    document.getElementById('orders-debug').innerHTML = `<div class="text-green-400">✅ Loaded ${orders.length} orders</div><pre>${JSON.stringify(orders, null, 2)}</pre>`;
                    document.getElementById('orders-debug').style.display = debugMode ? 'block' : 'none';
                } else {
                    document.getElementById('orders-debug').innerHTML = `<div class="text-red-400">❌ Error loading orders</div><pre>${JSON.stringify(orders, null, 2)}</pre>`;
                    document.getElementById('orders-debug').style.display = debugMode ? 'block' : 'none';
                }
            } catch (error) {
                document.getElementById('orders-debug').innerHTML = `<div class="text-red-400">❌ Network Error</div><pre>${error.message}</pre>`;
                document.getElementById('orders-debug').style.display = debugMode ? 'block' : 'none';
            }
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            updateTime();
            setInterval(updateTime, 1000);
            
            // Initialize charts
            initCharts();
            
            // Load initial data
            loadProducts();
            loadOrders();
            
            // Add initial activities
            setTimeout(() => {
                addActivity('E-commerce dashboard initialized', 'success');
                addActivity('Ready to test all microservices', 'info');
            }, 1000);
        });

        // Debug toggle event
        document.getElementById('debug-toggle').addEventListener('click', toggleDebugMode);
    </script>
